# Almaviva Visa Bot - Environment Variables Example
# Copy this file to .env and fill in your values

# Chrome Browser
USE_CHROME=1

# Proxy Settings (Optional)
PROXY_SERVER=
PROXY_USER=
PROXY_PASS=

# AI Guard (Optional)
AI_ENABLE=0
AI_MODE=guard
OPENAI_API_KEY=

# Rate Limiting
MAX_RPS=6
MAX_BURST=2
HUNT_SECONDS=25
MAX_CHECKS=60
BACKOFF_429_MS=3000

# Debug
PRINT_429=0
